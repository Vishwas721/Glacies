# Copy to .env and adjust. Never commit .env.

# --- docker compose ---
POSTGRES_USER=glacies
POSTGRES_PASSWORD=glacies
POSTGRES_DB=glacies
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- glacies (read by glacies.config.Settings) ---
GLACIES_CITY=bengaluru
GLACIES_DATA_DIR=data
GLACIES_DATABASE_URL=postgresql://glacies:glacies@localhost:5432/glacies
GLACIES_REDIS_URL=redis://localhost:6379/0
GLACIES_RANDOM_SEED=42
