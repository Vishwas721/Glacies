# Normalise line endings to LF in the repo regardless of OS.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Geospatial and analytical binaries — never diff or normalise.
*.pbf binary
*.osm.pbf binary
*.tif binary
*.tiff binary
*.parquet binary
*.duckdb binary
*.gpkg binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary

# Lockfiles: hide from diffs by default.
uv.lock linguist-generated=true -diff
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true -diff
