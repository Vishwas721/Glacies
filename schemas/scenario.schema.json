{
  "$defs": {
    "AddRoute": {
      "additionalProperties": false,
      "description": "A new route with evenly spaced trips; running times come from ``speed_kmh`` (Assumed).",
      "properties": {
        "dwell_secs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stop dwell; omitted means the city default.",
          "title": "Dwell Secs"
        },
        "feed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dataset of the stop ids; needed only if a stop id is ambiguous.",
          "title": "Feed"
        },
        "headway_secs": {
          "exclusiveMinimum": 0,
          "title": "Headway Secs",
          "type": "integer"
        },
        "mode": {
          "default": "bus",
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "one_way": {
          "default": false,
          "title": "One Way",
          "type": "boolean"
        },
        "return_stops": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stops in the other direction; omitted means the outbound stops reversed.",
          "title": "Return Stops"
        },
        "route_id": {
          "description": "New id; must not exist in any baseline feed.",
          "minLength": 1,
          "title": "Route Id",
          "type": "string"
        },
        "span": {
          "description": "First and last departure.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "description": "HH:MM or HH:MM:SS; hours may exceed 24.",
              "type": "string"
            },
            {
              "description": "HH:MM or HH:MM:SS; hours may exceed 24.",
              "type": "string"
            }
          ],
          "title": "Span",
          "type": "array"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Speed Kmh",
          "type": "number"
        },
        "stops": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Stops",
          "type": "array"
        },
        "type": {
          "const": "add_route",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "route_id",
        "stops",
        "headway_secs",
        "span",
        "speed_kmh"
      ],
      "title": "AddRoute",
      "type": "object"
    },
    "ModifyHeadway": {
      "additionalProperties": false,
      "description": "Change how often a route runs, inside ``window`` or over the whole day.\n\n``headway_factor`` scales the existing timetable: the gaps between departures are multiplied\nby the factor, so an irregular timetable keeps its shape (0.5 doubles the frequency).\n``headway_secs`` regularises it: the trips are replaced by evenly spaced departures.",
      "properties": {
        "feed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dataset name (city.toml [network]); needed only if route_id is in two feeds.",
          "title": "Feed"
        },
        "headway_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headway Factor"
        },
        "headway_secs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headway Secs"
        },
        "route_id": {
          "minLength": 1,
          "title": "Route Id",
          "type": "string"
        },
        "type": {
          "const": "modify_headway",
          "title": "Type",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "description": "HH:MM or HH:MM:SS; hours may exceed 24.",
                  "type": "string"
                },
                {
                  "description": "HH:MM or HH:MM:SS; hours may exceed 24.",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "required": [
        "route_id",
        "type"
      ],
      "title": "ModifyHeadway",
      "type": "object"
    },
    "RemoveRoute": {
      "additionalProperties": false,
      "description": "Drop every trip of a route.",
      "properties": {
        "feed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dataset name (city.toml [network]); needed only if route_id is in two feeds.",
          "title": "Feed"
        },
        "route_id": {
          "minLength": 1,
          "title": "Route Id",
          "type": "string"
        },
        "type": {
          "const": "remove_route",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "type"
      ],
      "title": "RemoveRoute",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A named change to the baseline network, applied in ``mutations`` order.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Editor hint; ignored by the engine.",
      "title": "$Schema"
    },
    "base_network": {
      "const": "baseline",
      "default": "baseline",
      "title": "Base Network",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "expected_change": {
      "default": "",
      "description": "The planner's expected direction of change (PRD validation 5).",
      "title": "Expected Change",
      "type": "string"
    },
    "mutations": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_route": "#/$defs/AddRoute",
            "modify_headway": "#/$defs/ModifyHeadway",
            "remove_route": "#/$defs/RemoveRoute"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RemoveRoute"
          },
          {
            "$ref": "#/$defs/ModifyHeadway"
          },
          {
            "$ref": "#/$defs/AddRoute"
          }
        ]
      },
      "minItems": 1,
      "title": "Mutations",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "mutations"
  ],
  "title": "Scenario",
  "type": "object"
}
